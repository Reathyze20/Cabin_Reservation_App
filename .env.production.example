# Rodinná produkce (chataceskestredohori.cz) z větve `rodina-stable`.
# Soubor na serveru: /home/reathyze/chata/.env (necommitovat).

DEPLOY_TARGET=production
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://chataceskestredohori.cz

DATABASE_URL="postgresql://USER:CHANGE_ME@localhost:5432/DBNAME?schema=public"

# Min. 32 znaků. Generovat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME

SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Chatačeskéstředohoří <noreply@chataceskestredohori.cz>"
