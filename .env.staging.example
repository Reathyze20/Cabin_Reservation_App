# Staging (staging.kdynachatu.cz) – vývoj pro víc rodin z větve `main`.
# Soubor na serveru: /home/reathyze/chata-staging/.env (necommitovat).
# remote-deploy.sh odmítne deploy, pokud hodnoty níže nesedí (docs/plans/SEP-1-deploy.md §4.2).

DEPLOY_TARGET=staging
NODE_ENV=production
PORT=3100
FRONTEND_URL=https://staging.kdynachatu.cz

# Samostatná DB a role bez přístupu k produkční DB. Název DB musí končit na _staging.
DATABASE_URL="postgresql://staging_app:CHANGE_ME@localhost:5432/kdynachatu_staging?schema=public"

# JINÝ klíč než produkce. Generovat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_STAGING_ONLY_MIN_32_CHARS

# E-maily ve stagingu vypnuté: prázdné SMTP_* = nic se neodesílá.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
